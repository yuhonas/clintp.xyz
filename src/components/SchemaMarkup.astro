---
import resume from "../../resume/resume.clintp.json";

const { pageType = "ProfilePage" } = Astro.props;

// Construct unique profile and website URLs
const sameAs = [...resume.basics.profiles.map((p) => p.url)];

// Construct educational institutions list
const alumniOf = resume.education
  .filter((edu) => edu.institution.toLowerCase().includes("university"))
  .map((edu) => ({
    "@type": "EducationalOrganization",
    name: edu.institution,
    url: edu.url || undefined,
    address: edu.location
      ? {
          "@type": "PostalAddress",
          addressLocality: edu.location,
        }
      : undefined,
  }));

// Retrieve skill names
const knowsAbout = resume.skills.map((s) => s.name);

const personId = `${resume.basics.url}/#person`;

// Construct standard Person schema entity
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": personId,
  name: resume.basics.name,
  alternateName:
    resume.basics.profiles.find((p) => p.network.toLowerCase() === "github")
      ?.username || undefined,
  image: resume.basics.image,
  email: resume.basics.email,
  url: resume.basics.url,
  jobTitle: resume.basics.label,
  description: resume.basics.summary,
  address: {
    "@type": "PostalAddress",
    addressLocality: resume.basics.location.city,
    addressRegion: resume.basics.location.region,
    addressCountry: resume.basics.location.countryCode,
  },
  sameAs: sameAs,
  alumniOf: alumniOf,
  knowsAbout: knowsAbout,
};

// Construct SoftwareSourceCode entities for resume projects
const softwareProjectsSchema = resume.projects.map((project) => ({
  "@type": "SoftwareSourceCode",
  name: project.name,
  description: project.description,
  codeRepository: project.url,
  url: project.url,
  author: {
    "@type": "Person",
    "@id": personId,
    name: resume.basics.name,
  },
  dateCreated: project.startDate,
  keywords: project.keywords ? project.keywords.join(", ") : undefined,
}));

// Construct top-level Page schema
const pageSchema = {
  "@context": "https://schema.org",
  "@type": pageType,
  url: `${resume.basics.url}`,
  name: `${resume.basics.name} - ${resume.basics.label}`,
  description: resume.basics.summary,
  mainEntity: personSchema,
  hasPart: softwareProjectsSchema,
};

const jsonLd = JSON.stringify(pageSchema);
---

<script type="application/ld+json" set:html={jsonLd} />
