---
const { title, description } = Astro.props["content"];

import resume from "../../resume/resume.clintp.json";

import { Image } from "astro:assets";

import logoGithub from "../images/logo-social-github.svg";
import logoLinkedIn from "../images/logo-social-linkedin.svg";

const logos = {
  github: logoGithub,
  linkedin: logoLinkedIn,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="title" property="og:title" content={title} />
    <meta name="image" property="og:image" content={resume.basics.image} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@500;700&family=Fira+Code:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <main
      class="min-h-screen bg-surface text-gray-300 font-sans scanlines relative pb-12"
    >
      <header
        class="inset-x-0 bottom-0 bg-surface-container-low border-b border-white/[0.03]"
      >
        <div class="mx-auto justify-between p-4 flex max-w-4xl items-center">
          <a
            href="/"
            class="items-center gap-3 flex font-mono text-primary-fixed hover:text-primary transition-colors duration-200"
          >
            <div class="relative flex h-2.5 w-2.5 mr-0.5">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2.5 w-2.5 bg-primary"
              ></span>
            </div>
            <img
              src="/favicon.svg"
              class="inline-block w-6 h-6 object-cover rounded-sm opacity-80"
              alt="Terminal Icon"
            />
            <h1 class="text-sm md:text-base font-bold tracking-tight">
              $ ./clintp.xyz
            </h1>
          </a>
          <nav class="flex gap-4">
            {
              resume.basics.profiles.map((profile) => (
                <a
                  href={profile.url}
                  class="transition-transform duration-300 hover:scale-110 flex items-center justify-center p-1.5 rounded-md bg-surface-container-high hover:bg-surface-container-highest"
                  rel="noopener"
                  target="_blank"
                  title={profile.network}
                >
                  <Image
                    src={logos[profile.network.toLowerCase()]}
                    alt={profile.network}
                    class="w-5 h-5 invert opacity-80 hover:opacity-100 transition-opacity"
                  />
                </a>
              ))
            }
          </nav>
        </div>
      </header>
      <article
        class="mx-auto max-w-3xl px-6 py-12 text-gray-300 selection:bg-primary-container selection:text-surface-container-lowest leading-relaxed text-base md:text-lg"
      >
        <slot />
      </article>
    </main>
  </body>
</html>
<style is:global>
  body {
    font-family: "Inter", sans-serif;
    background-color: #131313;
  }
  :root {
    --primary: #cebdff;
    --primary-container: #a78bfa;
    --accent-gradient: linear-gradient(135deg, #cebdff, #a78bfa);
  }

  .scanlines {
    position: relative;
  }
  .scanlines::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      rgba(167, 139, 250, 0.012) 0px,
      rgba(167, 139, 250, 0.012) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
    z-index: 50;
  }

  code {
    font-family: "Fira Code", Menlo, Monaco, "Courier New", monospace;
  }

  h2,
  h3,
  h4 {
    font-family: "Space Grotesk", sans-serif;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  h2 {
    @apply text-3xl md:text-4xl text-primary mt-12 mb-6;
  }

  h2:first-of-type {
    @apply mt-0;
  }

  h3 {
    @apply text-2xl md:text-3xl text-primary-fixed mt-8 mb-4;
  }

  .bg-surface-container-low h3 {
    @apply text-xl mt-0 mb-4;
  }

  .bg-surface-container-lowest ul {
    list-style-type: none;
    margin-left: 0;
    padding-left: 0;
    @apply space-y-4 mb-0;
  }

  .bg-surface-container-lowest li {
    position: relative;
    padding-left: 1.5rem;
    @apply text-sm leading-relaxed text-gray-300;
  }

  .bg-surface-container-lowest li::before {
    content: ">";
    position: absolute;
    left: 0;
    color: #cebdff;
    font-weight: bold;
  }

  h4 {
    @apply text-xl md:text-2xl text-primary-fixed mt-6 mb-3;
  }

  p {
    @apply mb-6 text-gray-300;
  }

  ul {
    @apply ml-6 mb-6 list-disc text-gray-300 space-y-2;
  }

  a {
    @apply text-primary-container font-medium hover:text-primary transition-colors duration-200;
  }

  a:hover {
    @apply underline decoration-primary/40 underline-offset-4;
  }

  a h1 {
    @apply text-primary-fixed;
  }
</style>
