---
const { title, description } = Astro.props["content"];

import resume from "../../resume/resume.clintp.json";

import { Image } from "astro:assets";

import logoGithub from "../images/logo-social-github.svg";
import logoLinkedIn from "../images/logo-social-linkedin.svg";
import SchemaMarkup from "../components/SchemaMarkup.astro";

const logos = {
  github: logoGithub,
  linkedin: logoLinkedIn,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={title} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={resume.basics.url} />
    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={resume.basics.url} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/profile-1200.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${resume.basics.name} — ${resume.basics.label}`}
    />
    <meta
      property="profile:first_name"
      content={resume.basics.name.split(" ")[0]}
    />
    <meta
      property="profile:last_name"
      content={resume.basics.name.split(" ")[1]}
    />
    <meta property="profile:username" content={resume.meta.username} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@500;700&family=Fira+Code:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="bf0941e6-f365-47a9-9a70-78c2c91bc8e1"></script>
    <SchemaMarkup pageType="ProfilePage" />
    <title>{title}</title>
  </head>
  <body>
    <main
      class="min-h-screen bg-surface text-gray-300 font-sans scanlines relative pb-12"
    >
      <header
        class="inset-x-0 bottom-0 bg-surface-container-low border-b border-white/[0.03]"
      >
        <div class="mx-auto justify-between p-4 flex max-w-4xl items-center">
          <a
            href="/"
            class="items-center gap-3 flex font-mono text-primary-fixed hover:text-primary transition-colors duration-200"
          >
            <img
              src="/favicon.svg"
              class="inline-block w-6 h-6 object-cover rounded-sm opacity-80"
              alt="Terminal Icon"
            />
            <span class="text-sm md:text-base font-bold tracking-tight">
              $ ./clintp.xyz
            </span>
          </a>
          <nav class="flex gap-4">
            {
              resume.basics.profiles.map((profile) => (
                <a
                  href={profile.url}
                  class="transition-transform duration-300 hover:scale-110 flex items-center justify-center p-1.5 rounded-md bg-surface-container-high hover:bg-surface-container-highest"
                  data-umami-event={`${profile.network.toLowerCase()}_click`}
                  data-umami-event-url={profile.url}
                  rel="noopener"
                  target="_blank"
                  title={profile.network}
                >
                  <Image
                    src={logos[profile.network.toLowerCase()]}
                    alt={profile.network}
                    class="w-5 h-5 invert opacity-80 hover:opacity-100 transition-opacity"
                  />
                </a>
              ))
            }
          </nav>
        </div>
      </header>
      <article
        class="mx-auto max-w-3xl px-6 py-12 text-gray-300 selection:bg-primary-container selection:text-surface-container-lowest leading-relaxed text-base md:text-lg"
      >
        <slot />
      </article>
    </main>
  </body><style is:global>
    body {
      font-family: "Inter", sans-serif;
      background-color: #131313;
    }
    :root {
      --primary: #cebdff;
      --primary-container: #a78bfa;
      --accent-gradient: linear-gradient(135deg, #cebdff, #a78bfa);
    }

    .scanlines {
      position: relative;
    }
    .scanlines::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: repeating-linear-gradient(
        rgba(167, 139, 250, 0.012) 0px,
        rgba(167, 139, 250, 0.012) 1px,
        transparent 1px,
        transparent 3px
      );
      pointer-events: none;
      z-index: 50;
    }

    code {
      font-family: "Fira Code", Menlo, Monaco, "Courier New", monospace;
    }

    h1,
    h2,
    h3,
    h4 {
      font-family: "Space Grotesk", sans-serif;
      letter-spacing: -0.02em;
      font-weight: 700;
    }

    h1 {
      @apply text-4xl md:text-5xl text-primary mb-8 mt-4;
    }

    h2 {
      @apply text-3xl md:text-4xl text-primary mt-12 mb-6;
    }

    h2:first-of-type {
      @apply mt-0;
    }

    h3 {
      @apply text-2xl md:text-3xl text-primary-fixed mt-8 mb-4;
    }

    .bg-surface-container-low h3 {
      @apply text-xl mt-0 mb-4;
    }

    .bg-surface-container-lowest ul {
      list-style-type: none;
      margin-left: 0;
      padding-left: 0;
      @apply space-y-4 mb-0;
    }

    .bg-surface-container-lowest li {
      position: relative;
      padding-left: 1.5rem;
      @apply text-sm leading-relaxed text-gray-300;
    }

    .bg-surface-container-lowest li::before {
      content: ">";
      position: absolute;
      left: 0;
      color: #cebdff;
      font-weight: bold;
    }

    h4 {
      @apply text-xl md:text-2xl text-primary-fixed mt-6 mb-3;
    }

    p {
      @apply mb-6 text-gray-300;
    }

    ul {
      @apply ml-6 mb-6 list-disc text-gray-300 space-y-2;
    }

    a {
      @apply text-primary-container font-medium hover:text-primary transition-colors duration-200;
    }

    a:hover {
      @apply underline decoration-primary/40 underline-offset-4;
    }

    a span {
      @apply text-primary-fixed;
    }
  </style>
</html>
